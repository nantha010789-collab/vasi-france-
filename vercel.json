{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app.html", "destination": "/index.html" },
    { "source": "/app-easy", "destination": "/index.html" },
    { "source": "/app-easy.html", "destination": "/index.html" },
    { "source": "/app-fixed", "destination": "/index.html" },
    { "source": "/app-fixed.html", "destination": "/index.html" },
    { "source": "/vasi-app", "destination": "/index.html" },
    { "source": "/vasi-app.html", "destination": "/index.html" },
    { "source": "/vasi-clean-start", "destination": "/index.html" },
    { "source": "/vasi-clean-start.html", "destination": "/index.html" },
    { "source": "/vasi-flow", "destination": "/index.html" },
    { "source": "/vasi-flow.html", "destination": "/index.html" },
    { "source": "/vasi-new", "destination": "/index.html" },
    { "source": "/vasi-new.html", "destination": "/index.html" },
    { "source": "/vasi-rich", "destination": "/index.html" },
    { "source": "/vasi-rich.html", "destination": "/index.html" },
    { "source": "/vasi-ui", "destination": "/index.html" },
    { "source": "/vasi-ui.html", "destination": "/index.html" },
    { "source": "/vasi", "destination": "/index.html" },
    { "source": "/vasi.html", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://js.stripe.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.supabase.co https://*.stripe.com https://maps.gstatic.com https://maps.googleapis.com; font-src 'self' data:; connect-src 'self' https://vhfyvkrvysrooaqzcxsp.supabase.co wss://vhfyvkrvysrooaqzcxsp.supabase.co https://api.stripe.com https://m.stripe.network https://*.googleapis.com https://*.google.com stun: turn: turns:; frame-src https://js.stripe.com https://hooks.stripe.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), autoplay=(), browsing-topics=(), camera=(self), display-capture=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(self), payment=(self \"https://js.stripe.com\"), publickey-credentials-create=(self), publickey-credentials-get=(self), usb=()" }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/account",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/account.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/settings.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/auth",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/auth.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/admin-login.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "cleanUrls": true,
  "functions": {
    "api/create-ride.js": { "includeFiles": "api/create-ride.js" },
    "api/ride-status.js": { "includeFiles": "api/ride-status.js" },
    "api/share-trip.js": { "includeFiles": "api/share-trip.js" },
    "api/shared-ride.js": { "includeFiles": "api/shared-ride.js" },
    "api/call-config.js": { "includeFiles": "api/call-config.js" },
    "api/ai-map-assist.js": { "includeFiles": "api/ai-map-assist.js" },
    "api/places.js": { "includeFiles": "api/places.js" },
    "api/create-payment-intent.js": {
      "includeFiles": "api/create-payment-intent.js"
    },
    "api/capture-payment.js": { "includeFiles": "api/capture-payment.js" },
    "api/driver-stripe-onboarding.js": {
      "includeFiles": "api/driver-stripe-onboarding.js"
    },
    "api/admin-bookings.js": { "includeFiles": "api/admin-bookings.js" },
    "api/admin-documents.js": { "includeFiles": "api/admin-documents.js" },
    "api/admin-drivers.js": { "includeFiles": "api/admin-drivers.js" },
    "api/admin-live-gps.js": { "includeFiles": "api/admin-live-gps.js" },
    "api/admin-stats.js": { "includeFiles": "api/admin-stats.js" },
    "api/restaurant-admin.js": { "includeFiles": "api/restaurant-admin.js" },
    "api/support.js": { "includeFiles": "api/support.js" },
    "api/pricing.js": { "includeFiles": "api/pricing.js" }
  }
}
